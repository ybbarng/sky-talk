# 의존성
node_modules/
.pnpm-store/

# Expo가 만드는 네이티브 프로젝트
# app.config.ts 에서 다시 만들 수 있으므로 저장소에 넣지 않는다.
# 손으로 고치면 다음 prebuild 에서 날아간다. (docs/08-build-release.md 참고)
#
# **맨 앞에 / 를 붙여 최상위만 가리킨다.** 안 붙이면 어느 깊이든
# `android` `ios` 라는 이름의 폴더를 다 잡아서, 우리가 손으로 쓴
# modules/*/android 와 modules/*/ios 까지 사라진다. 그러면 새로
# 받은 사람은 빌드를 못 한다.
/ios/
/android/
.expo/
expo-env.d.ts
dist/
web-build/

# 서명 열쇠 — 절대 올리지 않는다
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
*.cer

# 환경 변수
.env
.env.local
.env.*.local

# 만들어지는 아이콘 (assets/icon/*.svg 에서 다시 만든다)
assets/icon/generated/

# 우리가 쓴 네이티브 모듈은 남기고, 빌드 찌꺼기만 뺀다
modules/*/android/build/
modules/*/android/.cxx/

# 빌드 결과물
*.apk
*.aab
*.ipa
build/
.gradle/

# 데모를 묶은 결과물 (pnpm demo 로 다시 만든다)
demo/app.js
demo/favicon.svg

# 테스트
coverage/
.vitest/

# 도구
.DS_Store
*.log
.idea/
.vscode/
!.vscode/extensions.json
*.tsbuildinfo

# expo install 이 만드는 파일. 설정은 app.config.ts 한 곳에서만 관리한다.
app.json

# 에이전트 작업 트리
.claude/worktrees/
