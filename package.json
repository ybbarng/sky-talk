{
  "name": "sky-talk",
  "version": "0.1.0",
  "private": true,
  "description": "비행기에서 두 사람이 인터넷 없이 대화하는 앱",
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "dev:android": "pnpm icons:generate && JAVA_HOME=$(/usr/libexec/java_home -v 17) expo run:android",
    "dev:ios": "pnpm icons:generate && expo run:ios --device",
    "dev:ios:simulator": "pnpm icons:generate && expo run:ios",
    "build:ios": "pnpm icons:generate && expo run:ios --device --configuration Release --no-bundler",
    "prebuild": "pnpm icons:generate && expo prebuild --clean",
    "icons:generate": "tsx scripts/generate-icons.ts",
    "peer": "tsx scripts/peer-simulator.ts",
    "deps:add": "pnpm add --config.minimumReleaseAge=0",
    "deps:remove": "pnpm remove --config.minimumReleaseAge=0",
    "deps:expo": "npm_config_minimum_release_age=0 pnpm expo install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:deps": "tsx scripts/check-deps.ts",
    "check:tokens": "tsx scripts/check-tokens.ts",
    "check:native": "tsx scripts/check-native.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:deps && pnpm check:tokens && pnpm check:native && pnpm test",
    "build:android": "pnpm icons:generate && JAVA_HOME=$(/usr/libexec/java_home -v 17) expo run:android --variant release --no-bundler",
    "apk": "JAVA_HOME=$(/usr/libexec/java_home -v 17) sh -c \"cd android && ./gradlew assembleRelease\"",
    "release": "tsx scripts/release.ts",
    "demo:build": "tsx demo/build.ts",
    "demo:publish": "tsx demo/build.ts --publish",
    "demo": "tsx demo/build.ts && python3 -m http.server 8777 --directory demo --bind 127.0.0.1"
  },
  "dependencies": {
    "expo": "~56.0.22",
    "expo-audio": "~56.0.13",
    "expo-battery": "~56.0.4",
    "expo-constants": "~56.0.26",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.11",
    "expo-haptics": "~56.0.3",
    "expo-image-manipulator": "~56.0.26",
    "expo-image-picker": "~56.0.25",
    "expo-keep-awake": "~56.0.3",
    "expo-linking": "~56.0.18",
    "expo-network": "~56.0.5",
    "expo-notifications": "~56.0.25",
    "expo-router": "~56.2.21",
    "expo-sharing": "~56.0.26",
    "expo-splash-screen": "~56.0.15",
    "expo-sqlite": "~56.0.6",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-tcp-socket": "^6.4.3",
    "react-native-udp": "^4.1.7",
    "react-native-webrtc": "^124.0.8",
    "ulid": "^3.0.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^5.0.1",
    "lefthook": "^2.1.14",
    "react-test-renderer": "^19.3.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@biomejs/biome",
      "lefthook"
    ]
  }
}
